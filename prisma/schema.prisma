datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String  @id @default(cuid())
  email             String  @unique
  password          String
  firstname         String?
  lastname          String?
  username          String? @unique
  usernameUpdatedAt DateTime?
  role              Role    @default(CLIENT)

  pendingEmail                String?
  pendingEmailVerifyToken     String?
  pendingEmailVerifyExpires   DateTime?

  points          Int         @default(0)
  pointsExpiresAt DateTime?
  loyaltyTier     LoyaltyTier @default(BRONZE)

  isVerified Boolean @default(false)

  emailVerifyToken   String?
  emailVerifyExpires DateTime?
  emailLastSentAt    DateTime?

  passwordResetToken    String?
  passwordResetExpires  DateTime?

  orders Order[]

  loyaltyHistory LoyaltyLog[]
  loyaltyRewards LoyaltyReward[]
  promoCodeUsages PromoCodeUsage[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Float
  image       String?

  category            String?
  customizableText    Boolean @default(false)
  customizationPrice  Float     @default(0)
  availableColors     Json?
  unavailableColors   Json?
  colorZones          Json?
  packOptions         Json?
  inStock             Boolean @default(true)

  orderItems OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isArchived  Boolean  @default(false)
}

model Order {
  id String @id @default(cuid())

  orderNumber     String? @unique
  stripeSessionId String? @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status OrderStatus @default(PENDING)
  total  Float

  usedPoints Int   @default(0)
  discount   Float @default(0)

  rewardId             String?
  rewardTitle          String?
  rewardType           LoyaltyRewardType?
  rewardValue          Float?
  rewardSelectedOption String?

  items OrderItem[]

  welcomeOfferId      String?
  welcomeOfferCode    String?
  welcomeOfferValue   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WelcomeOfferStatus {
  SENT
  USED
  EXPIRED
}

model WelcomeOffer {
  id String @id @default(cuid())

  email String @unique
  code  String @unique

  value Float @default(10)

  type String @default("PERCENT")

  status WelcomeOfferStatus @default(SENT)

  usedAt DateTime?

  createdAt DateTime @default(now())
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String

  quantity Int
  price    Float

  selectedColor   String?
  selectedColors  Json?
  customText      String?
  packLabel       String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model LoyaltyLog {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id])

  type LoyaltyPointType
  points Int

  source String?
  metadata Json?

  expiresAt DateTime?

  createdAt DateTime @default(now())
}

enum Role {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
  CANCELLED_REFUNDED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  VIP
}

enum LoyaltyPointType {
  EARNED
  USED
  BONUS
  EXPIRED
}

enum LoyaltyRewardType {
  COUPON_EURO
  PERCENT
  PRODUCT_DISCOUNT
  FREE_PRODUCT
  GIFT
}

enum RewardStatus {
  ACTIVE
  USED
  EXPIRED
}

model LoyaltyReward {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  type  LoyaltyRewardType
  value Float?

  status RewardStatus @default(ACTIVE)

  source String?

  selectedOption String?

  createdAt DateTime @default(now())
  usedAt    DateTime?
}

model LoyaltyRewardRule {
  id String @id @default(cuid())

  title       String
  description String
  icon        String?

  pointsCost Int
  type       LoyaltyRewardType
  value      Float?

  options Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique
  userId       String

  user User @relation(fields: [userId], references: [id])

  expires DateTime
}

model SiteAnnouncement {
  id        String   @id @default(cuid())
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id String @id @default(cuid())

  code String @unique

  type  String @default("PERCENT")
  value Float

  isActive Boolean @default(true)

  usages PromoCodeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCodeUsage {
  id String @id @default(cuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])

  userId String
  user   User @relation(fields: [userId], references: [id])

  orderId String?

  usedAt DateTime @default(now())

  @@unique([promoCodeId, userId])
}

model ColorOption {
  id        String   @id @default(cuid())
  name      String
  hex       String
  isActive  Boolean  @default(true)
  inStock   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}